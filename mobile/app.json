{
  "expo": {
    "name": "EchoNotes",
    "slug": "echonotes",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-2.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-2.png",
      "resizeMode": "contain",
      "backgroundColor": "#090b10"
    },
    "androidStatusBar": {
      "backgroundColor": "#090b10",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echo8v.echonotes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-2.png",
        "backgroundColor": "#090b10"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.echo8v.echonotes",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "echonotes",
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EchoNotes to scan pairing codes from EchoNotes Desktop Bridge.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7fb",
          "image": "./assets/splash-icon-2.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090b10",
            "image": "./assets/splash-icon-2.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "170faac7-9c53-4292-bcaa-5b2f9d367c56"
      }
    }
  }
}
